Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Atomic}"
{
	%Group "Atomic"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Atomic/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Atomic: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Atomic"
	{
		!!MalterlibLibrary_Atomic true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Atomic: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Atomic true
	}
}

// Tests
Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Atomic"
	MalterlibTestFiles_Malterlib_Atomic: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

