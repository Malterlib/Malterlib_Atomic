Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Atomic}"
{
	%Group "Atomic"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Atomic/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Atomic true
	{
		&
		{
			MalterlibLibrary_Atomic ""
			MalterlibLibrary_All true
		}
	}
	MalterlibSubLibraries "Atomic;@(MalterlibSubLibraries)"
	{
		!!MalterlibLibrary_Atomic true
	}
//	MalterlibSubLibrarySeparate_Lib_Malterlib_Atomic true
	MalterlibIncludeRoots "@('Include'->MakeAbsolute());@(MalterlibIncludeRoots)"
	{
		!!MalterlibLibrary_Atomic true
	}
}

// Tests
Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests "Malterlib_Atomic;@(MalterlibTests)"
	MalterlibTestFiles_Malterlib_Atomic "@('Test/*'->MakeAbsolute())"
}

